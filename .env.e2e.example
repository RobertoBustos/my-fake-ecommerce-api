# Settings of the end-to-end suite (npm run test:e2e). Copy to .env.e2e,
# which git ignores, and fill it in. Never commit the real values.
E2E_BASE_URL=https://my-fake-ecommerce-150b2.web.app
# Optional: the Cloud Run URL, to check /healthcheck without Hosting in front.
E2E_RUN_URL=
E2E_FIREBASE_WEB_API_KEY=
E2E_EMAIL=
E2E_PASSWORD=
E2E_OTHER_EMAIL=
E2E_OTHER_PASSWORD=
# Must be a test key (sk_test_...); the suite refuses anything else.
E2E_STRIPE_SECRET_KEY=
# Global id of the product the suite buys.
E2E_PRODUCT_ID=
