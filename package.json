{
  "name": "my-fake-ecommerce-api",
  "version": "1.5.0",
  "main": "dist/index.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env ./dist/index.js",
    "dev": "tsx --env-file=.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "codegen": "graphql-codegen --config codegen.ts",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "test:e2e": "vitest run --config e2e/vitest.config.ts",
    "test:emulator": "firebase emulators:exec --only firestore,auth --project demo-ecommerce-api \"npm run test\"",
    "seed": "tsx scripts/seedFirestore.ts",
    "token:local": "tsx scripts/localToken.ts",
    "migrate:product-ids": "tsx scripts/migrateCartItemProductIds.ts",
    "rates:refresh": "tsx --env-file=.env src/jobs/refreshExchangeRates.ts",
    "inventory:process": "tsx src/jobs/processInventory.ts",
    "inventory:retry": "tsx scripts/retryInventoryTask.ts",
    "catalog:sync": "tsx src/jobs/syncCatalog.ts",
    "search:configure": "tsx scripts/configureSearchIndex.ts",
    "test:search:algolia": "vitest run --config tests/contract/vitest.hosted.config.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@google-cloud/firestore": "^9.3.1",
    "algoliasearch": "^5.60.0",
    "cors": "^2.8.6",
    "dataloader": "^2.2.3",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.0",
    "graphql": "^16.10.0",
    "graphql-depth-limit": "^1.1.0",
    "stripe": "^17.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/add": "^7.1.1",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typescript-resolvers": "^6.1.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/graphql-depth-limit": "^1.1.6",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv": "^16.4.7",
    "eslint": "^10.12.0",
    "firebase-tools": "^15.34.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
