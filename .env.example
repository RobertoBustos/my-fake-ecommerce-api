# Test-mode secret key (sk_test_...) from the Stripe dashboard.
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
# The webhook endpoint's "Signing secret" from Stripe (or the one printed by
# `stripe listen` when forwarding events to a local server).
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET
HOST=localhost
# Not 8080: the Firestore emulator already listens there (see firebase.json).
PORT=4000
# Optional: the Firebase project to use. Defaults to the "demo-ecommerce-api"
# demo project, which only works against the local emulator.
FIRESTORE_PROJECT_ID=demo-ecommerce-api
# Points firebase-admin at the local Firestore emulator. Remove it to use a
# real Firebase project.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Points firebase-admin at the local Auth emulator, so the API accepts the
# tokens from `npm run token:local`. Remove it to verify real Firebase tokens.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Optional: catalog sources that are switched on, comma separated. Defaults
# to "fs" (Firestore), the only source today.
CATALOG_SOURCES=fs
# Optional: how long (ms) the pricing settings (settings/pricing) are kept in
# memory before reading them again. Defaults to 30000.
PRICING_SETTINGS_TTL_MS=30000
# Only for the exchange rates job (npm run rates:refresh): token of Banxico's
# SIE API. Not needed while every price is already in the settlement currency.
BANXICO_TOKEN=YOUR_BANXICO_TOKEN
# Optional: minutes a stock reservation of a catalog source holds its units
# before it counts as expired, one variable per source key (fs → _FS).
# Defaults to 60.
RESERVATION_TTL_MINUTES_FS=60
# Optional: how many times the inventory job tries a confirm or release
# against its source before marking the task FAILED. Defaults to 8.
INVENTORY_TASK_MAX_ATTEMPTS=8
