STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
# El "Signing secret" que Stripe te da al crear el webhook endpoint (o el que
# imprime `stripe listen` en desarrollo local).
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET
HOST=localhost
PORT=8080
# Opcional: usa el emulador local (`firebase emulators:start`) o un proyecto
# real de Firebase. Si se omite, cae en el demo project "demo-ecommerce-api".
FIRESTORE_PROJECT_ID=demo-ecommerce-api